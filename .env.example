# 必填：阿里云百炼 API Key（主模型 qwen-plus + 默认 Embedding）
DASHSCOPE_API_KEY=sk-xxxx

# 可选：模型降级兜底（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 可选：联网搜索兜底（https://tavily.com 免费注册）
TAVILY_API_KEY=

# 可选：BGE-Reranker 精排 / BGE-M3 Embedding（https://siliconflow.cn 免费注册）
SILICONFLOW_API_KEY=

# 可选：向量库切换 milvus（默认 faiss），Milvus 地址如 http://localhost:19530
VECTOR_STORE=faiss
MILVUS_URI=

# 可选：Embedding 切换 siliconflow 的 BAAI/bge-m3（默认 dashscope text-embedding-v2）
EMBEDDING_PROVIDER=dashscope

# 可选：长期记忆数据库，默认本地 SQLite，PostgreSQL 示例：
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/assistant
DATABASE_URL=sqlite:///./assistant.db

# 可选：知识库命中阈值（Top-1 余弦相似度低于此值走联网兜底）
KB_THRESHOLD=0.45
